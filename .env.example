# SQLite file for servers, groups and tokens, relative to the repo root.
# Gitignored under .data/.
DB_PATH=.data/bangle.db

# What the app is accessed as in the browser, as a bare http(s) origin. The
# listener's own address works as is. Some OAuth providers only redirect to
# https: then put a TLS proxy (such as Caddy) in front and use its origin,
# e.g. https://7060.port.localhost.
BASE_URL=http://127.0.0.1:7060

# Seals upstream OAuth tokens in the DB (AES-256-GCM).
# 32 random bytes, base64: openssl rand -base64 32. Losing it means
# connecting every server again.
SECRETS_KEY=
